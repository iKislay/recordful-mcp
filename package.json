{
  "name": "recordful-mcp",
  "version": "0.3.0",
  "description": "Let any AI app record product demos with Recordful: an MCP server that drives the Recordful Chrome extension.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iKislay/recordful-mcp.git"
  },
  "homepage": "https://github.com/iKislay/recordful-mcp#readme",
  "bugs": {
    "url": "https://github.com/iKislay/recordful-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "recordful",
    "screen-recording",
    "product-demo",
    "browser-automation",
    "ai-agents",
    "claude"
  ],
  "bin": {
    "recordful-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "mcpName": "io.github.ikislay/recordful-mcp"
}
